{
  "name": "@vamvu/kuma",
  "version": "0.1.0",
  "description": "Kuma — multi-tenant WhatsApp assistant for service businesses",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:panel": "vite",
    "build": "npm run build:panel",
    "build:panel": "vite build",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/panel/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio:dev": "node scripts/guard-db-env.mjs --expect dev -- drizzle-kit studio",
    "db:studio:prod": "dotenv -e .env -v DATABASE_URL_FROM=PROD_DATABASE_URL -- node scripts/run-with-db.mjs node scripts/guard-db-env.mjs --expect prod -- drizzle-kit studio",
    "db:migrate:dev": "node scripts/guard-db-env.mjs --expect dev -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env -v DATABASE_URL_FROM=PROD_DATABASE_URL -- node scripts/run-with-db.mjs node scripts/guard-db-env.mjs --expect prod -- drizzle-kit migrate",
    "smoke:db": "tsx scripts/smoke-db.ts",
    "smoke:conversation": "tsx scripts/smoke-conversation.ts",
    "smoke:modules": "tsx scripts/smoke-modules.ts",
    "smoke:llm": "tsx scripts/smoke-llm.ts",
    "smoke:tools": "tsx scripts/smoke-tools.ts",
    "smoke:settings": "tsx scripts/smoke-settings.ts",
    "smoke:google": "tsx scripts/smoke-google.ts",
    "smoke:owner": "tsx scripts/smoke-owner.ts",
    "smoke:notifications": "tsx scripts/smoke-notifications.ts",
    "create:business": "tsx scripts/create-test-business.ts",
    "backfill:service-ids": "tsx scripts/backfill-service-ids.ts",
    "smoke:reminders": "tsx scripts/smoke-reminders.ts",
    "admin": "tsx scripts/admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@hono/node-server": "^2.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^173.0.0",
    "hono": "^4.12.24",
    "lucide-react": "^1.44.0",
    "nanoid": "^5.1.11",
    "openai": "^6.42.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.8"
  }
}
